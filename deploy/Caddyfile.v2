openrhiza.com, www.openrhiza.com {
	reverse_proxy 127.0.0.1:3000
}

aistockarena.com, www.aistockarena.com {
	# API 요청 프록시 (/api/* -> 8000)
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# 검색엔진 및 메타 파일 프록시
	@meta path /robots.txt /sitemap.xml /llms.txt /favicon.png
	handle @meta {
		reverse_proxy 127.0.0.1:8000
	}

	# 이전 /v2 링크 호환 리다이렉트
	redir /v2 / 302
	redir /v2/ / 302
	redir /v2/* / 302

	# V2 신규 React 대시보드 (메인)
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}

api.aistockarena.com {
	reverse_proxy 127.0.0.1:8000
}
